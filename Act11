const findPost=id=>GROUPS.flatMap(g=>g.posts).find(p=>p.id===id);
function likePost(id){const p=findPost(id);p.liked=!p.liked;p.likes+=p.liked?1:-1;renderGroup();}
function toggleReplies(id){const p=findPost(id);p.open=!p.open;renderGroup();if(p.open){const i=document.getElementById('rin'+id);i&&i.focus();}}
function sendReply(id){
  const i=document.getElementById('rin'+id),v=i.value.trim();if(!v){toast('Escribe tu respuesta');return;}
  const p=findPost(id);p.replies.push({a:'@USER',t:v});p.open=true;S.points+=30;refreshWallet();mark('hu3',4);renderGroup();toast('Respuesta publicada · +30 pts');
}
