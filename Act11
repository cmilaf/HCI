<!-- símbolos SVG reutilizables -->
<svg width="0" height="0" style="position:absolute">
  <defs>
    <symbol id="waveShape" viewBox="0 0 390 96" preserveAspectRatio="none">
      <path d="M0 0H390V78C360 98 335 58 300 76S240 98 205 76S140 56 105 78S35 96 0 74Z" fill="#f48a5c"/>
      <path d="M0 0H390V58C360 78 335 38 300 56S240 78 205 56S140 36 105 58S35 76 0 54Z" fill="#ffc28f"/>
      <path d="M0 0H390V36C360 56 335 16 300 34S240 56 205 34S140 14 105 36S35 54 0 32Z" fill="#f26a43"/>
      <path d="M0 0H390V16C360 30 335 2 300 14S240 30 205 14S140 0 105 16S35 28 0 12Z" fill="#ffb27a"/>
    </symbol>
    <symbol id="bcoin" viewBox="0 0 24 24">
      <path d="M3 5c6 2 12 12 18 14M3 19c6-2 12-12 18-14" stroke="#e0402a" stroke-width="2.4" fill="none" stroke-linecap="round"/>
      <path d="M3 9c5 1 10 7 18 8M3 15c5-1 10-7 18-8" stroke="#ff8a5c" stroke-width="1.4" fill="none" stroke-linecap="round"/>
    </symbol>
  </defs>
</svg>

<script>
/* =====================================================
   ESTADO GLOBAL
===================================================== */
const S = {
  points:100000, coins:10000,
  avatar:{skin:'s3',hair:'bun',hairColor:'brown',shirt:'yellow',pants:'indigo',acc:'beanie'},
  favMethod:null, method:null, cfg:{}, savedCfg:{},
  owned:new Set(), joined:new Set(['g5']),
  interest:'Todos', groupId:null, postFilter:'all'
};

const STORIES = [
  {id:'hu1', title:'Configuración del método de estudio', icon:'📚',
   story:'Como estudiante, quiero seleccionar y personalizar mi técnica de estudio preferida (Flashcards, Mapas Mentales, Resúmenes o Exámenes) para estudiar de la forma que mejor se adapte a mi estilo de aprendizaje.',
   steps:['Abrir "Métodos de estudio"','Elegir una técnica','Personalizar la configuración','Iniciar la sesión de estudio','Terminar la sesión y recibir recompensas'],
   go:'openMethods()'},
  {id:'hu2', title:'Personalización del avatar', icon:'🧑‍🎨',
   story:'Como usuario, quiero personalizar mi avatar 3D usando las BCoins que gané para darle identidad propia a mi perfil en la app.',
   steps:['Ir a Ajustes → Taller de Avatar','Previsualizar un artículo bloqueado','Comprarlo con BCoins','Equipar el artículo comprado','Guardar el avatar'],
   go:'openAvatar()'},
  {id:'hu3', title:'Foros de estudio en comunidad', icon:'💬',
   story:'Como estudiante, quiero unirme a grupos y foros con estudiantes de intereses similares para hacer preguntas y compartir recursos educativos.',
   steps:['Abrir Comunidad','Filtrar grupos por interés','Unirse a un grupo','Publicar una pregunta o recurso','Responder a un compañero'],
   go:'openCommunity()'}
];
const PROG = {hu1:new Set(),hu2:new Set(),hu3:new Set()};

function storiesHTML(){
  return STORIES.map(st=>{
    const done = PROG[st.id].size===st.steps.length;
    return `<div class="story ${done?'done':''}">
      <div class="hd"><h3>${st.icon} ${st.title}</h3><span class="tag">${done?'✓ COMPLETADA':PROG[st.id].size+'/'+st.steps.length}</span></div>
      <p>${st.story}</p>
      <ol>${st.steps.map((s,i)=>`<li class="${PROG[st.id].has(i)?'ok':''}"><span class="ck">${PROG[st.id].has(i)?'✓':i+1}</span>${s}</li>`).join('')}</ol>
      ${done?'':`<button class="go" onclick="${st.go}">Ir a esta tarea ›</button>`}
    </div>`;}).join('');
}
function renderStories(){
  const n=STORIES.filter(st=>PROG[st.id].size===st.steps.length).length;
  const d=document.getElementById('gearDot'); d.textContent=n+'/3'; d.style.background=n===3?'var(--green)':'';
  if(current==='settings') renderSettings();
}
function mark(id,i){
  if(PROG[id].has(i)) return;
  // marca también los pasos previos si se llegó por otra ruta
  for(let k=0;k<=i;k++) PROG[id].add(k);
  renderStories();
  const st = STORIES.find(s=>s.id===id);
  if(PROG[id].size===st.steps.length) setTimeout(()=>toast('🎉 Historia completada: '+st.title),700);
}

/* =====================================================
   UTILIDADES
===================================================== */
const fmt = n=>n.toLocaleString('en-US');
const k = n=>n>=1000?(Math.round(n/100)/10).toString().replace('.0','')+' K':n;
const esc = s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let toastT;
function toast(m){const t=document.getElementById('toast');t.textContent=m;t.classList.add('show');clearTimeout(toastT);toastT=setTimeout(()=>t.classList.remove('show'),2300);}
function openModal(html){document.getElementById('sheet').innerHTML=html;document.getElementById('modal').classList.add('show');}
function closeModal(){document.getElementById('modal').classList.remove('show');}
function refreshWallet(){
  document.getElementById('homePoints').textContent=fmt(S.points);
  ['homeCoins','avCoins','shopCoins'].forEach(id=>document.getElementById(id).textContent=k(S.coins));
}

const NAVMAP = {home:'home',methods:'home',config:'home',session:'home',done:'home',community:'community',group:'community',avatar:'settings',shop:'settings',settings:'settings'};
let current='home';
function go(id){
  if(current==='session' && id!=='session' && id!=='done'){ stopTimer(); }
  current=id;
  document.querySelectorAll('.screen').forEach(s=>s.classList.toggle('active',s.id==='s-'+id));
  document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('on',b.dataset.nav===NAVMAP[id]));
  document.getElementById('fab').classList.toggle('show', id==='group' && S.joined.has(S.groupId));
  document.getElementById('s-'+id).scrollTop=0;
  ({home:renderHome,methods:renderMethods,avatar:renderAvatarScreen,shop:renderShop,community:renderCommunity,group:renderGroup,settings:renderSettings}[id]||(()=>{}))();
}

/* =====================================================
   AVATAR (SVG)
===================================================== */
const SKIN={s1:'#f3cba5',s2:'#dba27a',s3:'#a86b45',s4:'#6b4128'};
const HAIRC={brown:'#a8643a',black:'#2b1d16',blonde:'#e8c26a',pink:'#f48fb1',blue:'#5c7cfa'};
const SHIRT={blue:'#5b8def',yellow:'#ffe066',white:'#f5f5f5',red:'#ef5350',galaxy:'#6c3fd1'};
const PANTS={indigo:'#5a5fe0',black:'#2a2a3a',jeans:'#3f6fb5',orange:'#ff8a3d'};

function avatarSVG(a,mode='full'){
  const vb = mode==='head'?'50 14 100 100':(mode==='bust'?'40 10 120 170':'30 0 140 255');
  const sk=SKIN[a.skin], hc=HAIRC[a.hairColor], sh=SHIRT[a.shirt], pa=PANTS[a.pants];
  let back='',front='',acc='';
  const cap=`<path d="M72 60C70 32 130 32 128 60C122 47 110 43 100 44C90 43 78 47 72 60Z" fill="${hc}"/>`;
  if(a.hair==='bob'){ back=`<rect x="69" y="40" width="62" height="52" rx="24" fill="${hc}"/>`; front=cap; }
  if(a.hair==='bun'){ front=cap+`<circle cx="100" cy="28" r="12" fill="${hc}"/>`; }
  if(a.hair==='short'){ front=`<path d="M73 56C72 34 128 34 127 56C120 50 112 47 100 48C88 47 80 50 73 56Z" fill="${hc}"/>`; }
  if(a.hair==='curly'){ back=`<rect x="70" y="46" width="60" height="34" rx="16" fill="${hc}"/>`;
    front=[[76,50],[86,39],[100,35],[114,39],[124,50],[71,64],[129,64]].map(([x,y])=>`<circle cx="${x}" cy="${y}" r="10" fill="${hc}"/>`).join(''); }
  if(a.acc==='glasses') acc=`<circle cx="91" cy="62" r="7" fill="#1b1b1b" opacity=".9"/><circle cx="109" cy="62" r="7" fill="#1b1b1b" opacity=".9"/><path d="M98 61h4M84 60l-11-2M116 60l11-2" stroke="#1b1b1b" stroke-width="2"/>`;
  if(a.acc==='beanie') acc=`<circle cx="79" cy="31" r="8" fill="#ff8fb1"/><circle cx="121" cy="31" r="8" fill="#ff8fb1"/><path d="M71 54C71 24 129 24 129 54Z" fill="#ff8fb1"/><rect x="69" y="47" width="62" height="10" rx="5" fill="#ff6b98"/>`;
  if(a.acc==='headphones') acc=`<path d="M72 60C70 22 130 22 128 60" stroke="#222" stroke-width="5" fill="none"/><rect x="65" y="52" width="11" height="18" rx="5" fill="#ff7a00"/><rect x="124" y="52" width="11" height="18" rx="5" fill="#ff7a00"/>`;
  if(a.acc==='crown') acc=`<path d="M78 40l6-16 8 10 8-14 8 14 8-10 6 16z" fill="#ffc107" stroke="#e09b00" stroke-width="1.5"/>`;
  return `<svg viewBox="${vb}" xmlns="http://www.w3.org/2000/svg">
    ${back}
