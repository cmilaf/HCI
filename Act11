  <!-- COMUNIDAD -->
  <section class="screen bg-blue" id="s-community">
    <svg class="wave" viewBox="0 0 390 96" preserveAspectRatio="none"><use href="#waveShape"/></svg>
    <div class="title" style="margin-top:0">Comunidad</div>
    <div class="pad">
      <input class="search" id="gSearch" placeholder="🔍  Buscar grupos o temas…" oninput="renderGroups()">
