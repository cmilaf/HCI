        <button id="undoBtn" onclick="undo()" title="Deshacer"><svg viewBox="0 0 30 30"><path d="M11 8L5 14l6 6"/><path d="M5 14h13a7 7 0 017 7v2"/></svg></button>
        <button id="redoBtn" onclick="redo()" title="Rehacer"><svg viewBox="0 0 30 30"><path d="M19 8l6 6-6 6"/><path d="M25 14H12a7 7 0 00-7 7v2"/></svg></button>
      </div>
      <button class="shop-btn" onclick="go('shop')">TIENDA<svg viewBox="0 0 40 40"><path d="M5 8h30l2 9H3z"/><path d="M3 17c0 3 3 5 6 5s6-2 6-5c0 3 3 5 5 5s6-2 6-5c0 3 3 5 6 5s5-2 5-5M6 22v14h28V22M15 36v-9h10v9"/></svg></button>
      <div class="av-fig" id="avFig"></div>
      <div class="av-tabs"><button id="tabA" class="on" onclick="setTab('apariencia')">APARIENCIA</button><button id="tabC" onclick="setTab('closet')">CLOSET</button></div>
    </div>
    <div class="catbar"><button onclick="cycleCat(-1)">«</button><span id="catName">CABELLO</span><button onclick="cycleCat(1)">»</button></div>
    <div class="items" id="itemGrid"></div>
    <div class="buybar" id="buybar"><span id="buyTxt"></span><button class="btn-orange" onclick="askBuy(pendingItem)">Comprar</button></div>
  </section>

  <!-- TIENDA -->
  <section class="screen bg-blue" id="s-shop">
    <svg class="wave" viewBox="0 0 390 96" preserveAspectRatio="none"><use href="#waveShape"/></svg>
    <button class="back" onclick="go('avatar')">‹</button>
    <div class="title" style="margin-top:0">Tienda</div>
    <div class="pad">
      <div class="coinbox bc" style="margin:0 auto 14px;width:max-content"><svg viewBox="0 0 24 24"><use href="#bcoin"/></svg><span id="shopCoins">10 K</span></div>
      <div class="shop-list" id="shopList"></div>
