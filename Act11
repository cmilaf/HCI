  if(postType==='q') setTimeout(()=>{const p=g.posts[0];if(p&&p.mine){p.replies.push({a:'@diego_ing',t:'¡Buena pregunta! Te dejo un ejemplo en los recursos del grupo 👀'});p.open=true;if(current==='group')renderGroup();toast('💬 @diego_ing respondió tu pregunta');}},3500);
}

