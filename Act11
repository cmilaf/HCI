let SS=null, timer=null, paused=false;
function shuffle(a){return a.map(x=>[Math.random(),x]).sort((p,q)=>p[0]-q[0]).map(x=>x[1]);}
function startSession(){
  S.savedCfg[S.method]={...S.cfg};
  if(S.cfg.fav){S.favMethod=S.method;}else if(S.favMethod===S.method){S.favMethod=null;}
  mark('hu1',3);
  const deck=DECKS[S.cfg.materia];
  SS={method:S.method,secs:S.cfg.pomodoro*60,elapsed:0,pts:0,idx:0,ok:0,fail:0,branches:[],answered:false,
      tema:S.cfg.tema||S.cfg.materia};
  if(S.method==='flash'){let c=[];while(c.length<S.cfg.cantidad)c=c.concat(deck);c=c.slice(0,S.cfg.cantidad);SS.cards=S.cfg.orden==='Aleatorio'?shuffle(c):c;}
  if(S.method==='examen'){
    SS.qs=shuffle(deck).slice(0,S.cfg.preguntas).map(([q,a])=>{
      if(S.cfg.tipo==='Opción múltiple'){const others=shuffle(deck.filter(d=>d[1]!==a)).slice(0,3).map(d=>d[1]);return {q,opts:shuffle([a,...others]),a};}
      const truth=Math.random()<.5; const shown=truth?a:shuffle(deck.filter(d=>d[1]!==a))[0][1];
      return {q:`${q}: «${shown}»`,opts:['Verdadero','Falso'],a:truth?'Verdadero':'Falso'};
    });
  }
  if(S.method==='resumen'){SS.target={Corto:25,Medio:45,Largo:70}[S.cfg.extension];SS.keys=deck.slice(0,4).map(d=>d[1]);SS.checked=new Set();SS.text='';}
  document.getElementById('sessMethodLbl').textContent=METHODS[S.method].name.toUpperCase();
  paused=false; go('session'); renderStudy(); startTimer();
}
function startTimer(){
  stopTimer(); updTimer();
  timer=setInterval(()=>{if(paused)return;SS.secs--;SS.elapsed++;updTimer();
    if(SS.secs<=0){stopTimer();toast('⏰ ¡Pomodoro terminado! Toma tu descanso de '+S.cfg.descanso+' min');}},1000);
}
function stopTimer(){clearInterval(timer);}
function pauseTimer(b){paused=!paused;b.classList.toggle('off',paused);
  document.getElementById('pauseIco').innerHTML=paused?'<path d="M8 5l11 7-11 7z"/>':'<path d="M9 5v14M15 5v14"/>';toast(paused?'Pomodoro en pausa':'Pomodoro reanudado');}
function updTimer(){const m=Math.floor(SS.secs/60),s=SS.secs%60;document.getElementById('tTime').textContent=`${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;document.getElementById('tPts').textContent=fmt(SS.pts);}
function addPts(n){SS.pts+=n;updTimer();}

function renderStudy(){
  const box=document.getElementById('studyBox'); const M=SS.method;
  if(M==='flash'){
    const n=SS.cards.length;
    if(SS.idx>=n){box.innerHTML=`<div class="done-msg"><b>🃏</b><h3>¡Mazo terminado!</h3><p style="margin:10px 0;font-weight:600">Dominaste <b>${SS.ok}</b> de ${n} tarjetas.</p>
      <button class="btn-navy" style="padding:10px 16px" onclick="SS.idx=0;SS.cards=shuffle(SS.cards);renderStudy()">Repasar otra vez</button></div><p style="text-align:center;font-size:12px;font-weight:700;color:#5a6a8c;margin-top:12px">Pulsa «Terminar sesión» para cobrar tus recompensas</p>`;return;}
    const [f,b]=SS.cards[SS.idx];
