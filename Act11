    <div class="pad" id="groupBody" style="margin-top:-20px"></div>
  </section>

  <!-- AJUSTES -->
  <section class="screen bg-blue" id="s-settings">
    <svg class="wave" viewBox="0 0 390 96" preserveAspectRatio="none"><use href="#waveShape"/></svg>
