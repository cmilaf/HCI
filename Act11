        <button onclick="pauseTimer(this)" title="Pausar pomodoro"><svg viewBox="0 0 24 24" id="pauseIco"><path d="M9 5v14M15 5v14"/></svg></button>
        <button class="off" onclick="this.classList.toggle('off');toast(this.classList.contains('off')?'Cámara apagada':'Cámara encendida: tus compañeros te ven estudiar')"><svg viewBox="0 0 24 24"><rect x="3" y="7" width="12" height="10" rx="2"/><path d="M15 11l6-3v8l-6-3"/></svg></button>
