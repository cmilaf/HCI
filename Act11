function publishPost(){
  const t=document.getElementById('pTitle').value.trim(),x=document.getElementById('pText').value.trim(),l=postType==='r'?document.getElementById('pLink').value.trim():'';
  if(!t||!x){toast('Completa el título y la descripción');return;}
  if(postType==='r'&&!l){toast('Agrega el enlace o archivo del recurso');return;}
  const g=GROUPS.find(z=>z.id===S.groupId);
  g.posts.unshift({id:Date.now()%1e7,author:'@USER',mine:true,type:postType,title:t,text:x,link:l,likes:0,replies:[]});
  S.points+=50;refreshWallet();closeModal();S.postFilter='all';mark('hu3',3);renderGroup();
  toast((postType==='q'?'Pregunta':'Recurso')+' publicado · +50 pts');
