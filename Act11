<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>BEACON · Prototipo interactivo (Actividad 11)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --orange:#ff6a2b; --orange2:#ff7a00; --peach:#ffcf99; --cream:#fff4df;
  --sky:#6fa3e0; --sky2:#8db8ea; --navy:#2d3e5e; --deep:#0b4db3; --ink:#0a1f4d;
  --purple:#3d2fbf; --lightblue:#c9defb; --red:#ef5350; --green:#2bb673;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Montserrat',Arial,sans-serif;background:#0f1730;color:#fff;min-height:100vh;
  display:flex;gap:40px;justify-content:center;align-items:center;padding:30px 20px;flex-wrap:wrap}
button{font-family:inherit;cursor:pointer;border:none}
input,textarea,select{font-family:inherit}

/* ---------- Panel lateral ---------- */
.panel{width:380px;max-width:100%}
.panel h1{font-size:30px;font-weight:900;letter-spacing:1px;color:var(--orange2)}
.panel .sub{font-size:13px;color:#b9c6e6;margin:4px 0 18px;line-height:1.45}
.story{background:#18234a;border:2px solid #263569;border-radius:16px;padding:14px 16px;margin-bottom:14px;transition:.3s}
.story.done{border-color:var(--green);background:#123b37}
.story .hd{display:flex;justify-content:space-between;align-items:center;gap:8px}
.story h3{font-size:14px;font-weight:800;text-transform:uppercase;color:#fff}
.story .tag{font-size:11px;font-weight:800;padding:3px 8px;border-radius:20px;background:var(--orange2);color:#fff;white-space:nowrap}
.story.done .tag{background:var(--green)}
.story p{font-size:12px;color:#c5d1ee;margin:8px 0;line-height:1.45;font-style:italic}
.story ol{list-style:none;font-size:12.5px}
.story li{display:flex;gap:8px;align-items:center;padding:4px 0;color:#aab6d6}
.story li .ck{width:18px;height:18px;border-radius:50%;border:2px solid #4b5b92;display:grid;place-items:center;font-size:11px;flex:none}
.story li.ok{color:#fff}
.story li.ok .ck{background:var(--green);border-color:var(--green)}
.story .go{margin-top:8px;font-size:12px;font-weight:800;background:#2a3a78;color:#fff;padding:7px 12px;border-radius:10px}
.story .go:hover{background:var(--deep)}
.reset{font-size:12px;font-weight:700;color:#b9c6e6;background:none;text-decoration:underline}

/* ---------- Teléfono ---------- */
.phone{width:390px;height:820px;background:#111;border-radius:58px;padding:12px;position:relative;
  box-shadow:0 0 0 3px #c9c9cf,0 0 0 6px #7b7b82,0 30px 60px rgba(0,0,0,.5);flex:none}
.inner{width:100%;height:100%;border-radius:46px;overflow:hidden;position:relative;background:#fff}
.island{position:absolute;top:10px;left:50%;transform:translateX(-50%);width:110px;height:32px;background:#000;border-radius:20px;z-index:50}
.screen{position:absolute;inset:0 0 72px 0;overflow-y:auto;overflow-x:hidden;display:none;scrollbar-width:none}
.screen::-webkit-scrollbar{display:none}
.screen.active{display:block;animation:fade .25s}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.wave{display:block;width:100%;height:96px}
.bg-blue{background:linear-gradient(180deg,var(--sky) 0%,var(--sky2) 60%,#c7dcf3 100%)}
.bg-cream{background:var(--cream)}
.title{font-weight:900;color:var(--ink);text-align:center;font-size:24px;letter-spacing:.5px;text-transform:uppercase;margin:8px 16px 16px}
.pad{padding:0 18px 24px}
.back{position:absolute;top:52px;left:16px;z-index:5;background:rgba(255,255,255,.85);color:var(--ink);width:34px;height:34px;border-radius:50%;font-size:18px;font-weight:900;display:grid;place-items:center;box-shadow:0 2px 6px rgba(0,0,0,.15)}

/* nav */
.nav{position:absolute;left:0;right:0;bottom:0;height:72px;background:var(--deep);display:grid;grid-template-columns:repeat(3,1fr);z-index:20}
.nav button{background:none;display:grid;place-items:center;position:relative}
.nav svg{width:34px;height:34px;stroke:#0a0f22;fill:none;stroke-width:1.6}
.nav button.on::before{content:"";position:absolute;top:-4px;width:40px;height:8px;border-radius:6px;background:var(--orange2)}
.nav button.on svg{stroke:#000;stroke-width:2.1}

/* comunes */
.btn-navy{background:var(--navy);color:#fff;font-weight:800;text-transform:uppercase;border-radius:12px;box-shadow:0 4px 8px rgba(0,0,0,.25)}
.btn-orange{background:var(--orange2);color:#fff;font-weight:800;border-radius:12px;padding:12px 16px;text-transform:uppercase;box-shadow:0 4px 8px rgba(0,0,0,.2)}
.btn-ghost{background:#fff;color:var(--ink);font-weight:800;border-radius:12px;padding:12px 16px;text-transform:uppercase}
.btn-orange:disabled{opacity:.45;cursor:not-allowed}
.toast{position:absolute;left:50%;bottom:90px;transform:translateX(-50%) translateY(20px);background:var(--ink);color:#fff;font-size:13px;font-weight:700;
  padding:10px 16px;border-radius:14px;opacity:0;transition:.3s;z-index:90;width:max-content;max-width:330px;text-align:center;pointer-events:none;box-shadow:0 6px 16px rgba(0,0,0,.3)}
.toast.show{opacity:1;transform:translateX(-50%)}
.modal{position:absolute;inset:0;background:rgba(5,12,35,.55);display:none;align-items:flex-end;z-index:80}
.modal.show{display:flex}
.sheet{background:#fff;color:var(--ink);width:100%;border-radius:26px 26px 0 0;padding:22px 20px 30px;animation:up .25s;max-height:85%;overflow:auto}
@keyframes up{from{transform:translateY(40px)}to{transform:none}}
.sheet h3{font-weight:900;font-size:19px;text-transform:uppercase;margin-bottom:10px}
.sheet p{font-size:14px;line-height:1.45;margin-bottom:14px}
.sheet .row{display:flex;gap:10px}
.sheet .row button{flex:1}
.bc{display:inline-flex;align-items:center;gap:6px}
.bc svg{width:24px;height:24px}

/* ---------- HOME ---------- */
.home-top{background:var(--cream);padding-bottom:16px;text-align:center}
.home-top .wave{margin-bottom:-60px}
.avatar-circle{width:150px;height:150px;border-radius:50%;background:#2d8fdc;margin:0 auto;overflow:hidden;box-shadow:0 6px 14px rgba(0,0,0,.25);position:relative}
.avatar-circle svg{width:100%;height:100%}
.uname{color:#111;font-weight:800;font-size:18px;margin-top:12px}
.home-body{background:#fff;padding:16px 18px 24px;color:#111}
.hgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.welcome{font-weight:800;font-size:13px;margin:6px 0 12px 8px}
.start-card{background:var(--orange);color:#fff;border-radius:14px;padding:14px;height:142px;text-align:left;font-weight:700;font-size:13px;text-transform:uppercase;
  display:flex;flex-direction:column;justify-content:space-between;box-shadow:0 4px 8px rgba(0,0,0,.2)}
.start-card svg{width:52px;height:52px;align-self:center}
.pill{background:var(--orange2);color:#111;font-weight:800;font-size:13px;text-align:center;border-radius:12px;padding:7px;box-shadow:0 3px 6px rgba(0,0,0,.15)}
.valbox{background:var(--peach);border-radius:12px;padding:10px;text-align:center;font-size:21px;font-weight:600;margin:6px 0 10px;box-shadow:0 3px 6px rgba(0,0,0,.12);color:#111}
.methods-btn{width:100%;background:var(--lightblue);color:#111;font-weight:800;padding:13px;border-radius:12px;margin:6px 0 12px;font-size:14px;box-shadow:0 3px 6px rgba(0,0,0,.12)}
.big2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.big2 button{height:116px;border-radius:14px;color:#fff;font-weight:700;font-size:15px;text-transform:uppercase;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;box-shadow:0 4px 8px rgba(0,0,0,.25)}
.big2 svg{width:46px;height:46px;stroke:#fff;fill:none;stroke-width:1.6}

/* ---------- MÉTODOS ---------- */
.mbtn{width:100%;height:104px;margin-bottom:18px;font-size:19px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;transition:.15s}
.mbtn small{font-size:11px;font-weight:600;text-transform:none;color:#b8c7e6}
.mbtn:hover{transform:scale(1.02)}
.mbtn.fav{outline:3px solid var(--orange2)}

/* ---------- CONFIG ---------- */
.cfg-card{background:#fff;color:var(--ink);border-radius:18px;padding:16px;margin-bottom:14px;box-shadow:0 4px 10px rgba(0,0,0,.15)}
.cfg-card h4{font-size:12px;font-weight:800;text-transform:uppercase;color:#5a6a8c;margin-bottom:8px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{background:#eaf1fc;color:var(--ink);font-weight:700;font-size:13px;padding:8px 13px;border-radius:20px;border:2px solid transparent}
.chip.on{background:var(--navy);color:#fff}
.cfg-card input[type=text]{width:100%;padding:11px;border-radius:10px;border:2px solid #dbe5f5;font-size:14px;font-weight:600;color:var(--ink)}
.toggle{display:flex;justify-content:space-between;align-items:center;font-size:13px;font-weight:700}
.sw{width:46px;height:26px;border-radius:20px;background:#cfd8ea;position:relative;transition:.2s}
.sw::after{content:"";position:absolute;width:20px;height:20px;border-radius:50%;background:#fff;top:3px;left:3px;transition:.2s}
.sw.on{background:var(--green)}
.sw.on::after{left:23px}
.method-badge{display:flex;align-items:center;gap:10px;background:var(--navy);color:#fff;padding:12px 14px;border-radius:14px;margin-bottom:14px;font-weight:800;text-transform:uppercase;font-size:15px}
.method-badge span{font-size:24px}

/* ---------- SESIÓN ---------- */
.stats{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:6px}
.stat{background:var(--deep);border-radius:10px;padding:10px 12px;display:flex;justify-content:space-between;align-items:center;font-size:20px;font-weight:600;box-shadow:0 4px 8px rgba(0,0,0,.25)}
.stat svg{width:30px;height:30px}
.stat-l{display:flex;justify-content:space-between;font-size:10px;font-weight:800;color:var(--ink);padding:0 8px;margin-bottom:12px}
.study{background:#fff;color:var(--ink);border-radius:18px;padding:16px;min-height:300px;box-shadow:0 4px 12px rgba(0,0,0,.2);margin-bottom:14px}
.prog{height:8px;background:#e3ebf8;border-radius:6px;overflow:hidden;margin-bottom:12px}
.prog i{display:block;height:100%;background:var(--orange2);transition:.3s}
.fc{perspective:900px;height:190px;margin-bottom:14px;cursor:pointer}
.fc-in{position:relative;width:100%;height:100%;transition:transform .5s;transform-style:preserve-3d}
.fc.flip .fc-in{transform:rotateY(180deg)}
.fc-f,.fc-b{position:absolute;inset:0;backface-visibility:hidden;border-radius:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:16px;text-align:center;font-weight:800;font-size:21px}
.fc-f{background:var(--navy);color:#fff}
.fc-b{background:var(--peach);color:var(--ink);transform:rotateY(180deg)}
.fc small{font-size:11px;font-weight:600;opacity:.7;margin-top:10px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.two button{padding:12px;border-radius:12px;font-weight:800;color:#fff;font-size:13px}
.opt{display:block;width:100%;text-align:left;background:#eef3fb;color:var(--ink);padding:12px 14px;border-radius:12px;margin-bottom:8px;font-weight:700;font-size:14px;border:2px solid transparent}
.opt.right{background:#d8f5e6;border-color:var(--green)}
.opt.wrong{background:#fde1e1;border-color:var(--red)}
.q{font-weight:800;font-size:17px;margin-bottom:12px}
.mm svg{width:100%;height:230px}
.addrow{display:flex;gap:8px;margin:8px 0}
.addrow input{flex:1;padding:10px;border-radius:10px;border:2px solid #dbe5f5;font-weight:600}
.addrow button{background:var(--orange2);color:#fff;font-weight:900;border-radius:10px;padding:0 14px;font-size:18px}
.sugg{display:flex;flex-wrap:wrap;gap:6px}
.sugg button{font-size:11px;font-weight:700;background:#eaf1fc;color:var(--ink);padding:6px 10px;border-radius:14px}
.study textarea{width:100%;height:150px;border-radius:12px;border:2px solid #dbe5f5;padding:10px;font-size:13px;font-weight:500;resize:none;color:var(--ink)}
.chk{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}
.chk label{font-size:12px;font-weight:700;background:#eef3fb;padding:6px 10px;border-radius:14px;display:flex;gap:5px;align-items:center;cursor:pointer}
.meta{font-size:12px;font-weight:700;color:#5a6a8c;display:flex;justify-content:space-between;margin-top:6px}
.calls{display:flex;justify-content:center;gap:18px;background:var(--deep);border-radius:40px;padding:10px 18px;width:max-content;margin:0 auto 14px}
.calls button{width:52px;height:52px;border-radius:50%;background:#ffb000;display:grid;place-items:center}
.calls button.off{background:#8a95b3}
.calls svg{width:26px;height:26px;stroke:var(--deep);fill:none;stroke-width:2.2}
.end-row{display:flex;justify-content:center;align-items:center;gap:12px}
.end-btn{background:#020b30;color:#fff;font-weight:800;font-size:12px;padding:13px 40px;border-radius:12px;text-transform:uppercase}
.done-msg{text-align:center;padding:10px 0}
.done-msg b{font-size:40px;display:block}

/* ---------- RESULTADOS ---------- */
.trophy{width:120px;height:120px;border-radius:50%;background:var(--orange2);display:grid;place-items:center;margin:0 auto 14px;font-size:58px;box-shadow:0 8px 18px rgba(0,0,0,.25)}
.res{background:#fff;color:var(--ink);border-radius:18px;padding:16px;margin-bottom:14px}
.res .r{display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px dashed #d4ddee;font-weight:700;font-size:14px}
.res .r:last-child{border:none}
.res .r b{color:var(--orange)}

/* ---------- AVATAR ---------- */
.av-top{background:var(--peach);position:relative}
#s-avatar .back{top:66px}
#s-avatar .av-head{padding-left:58px}
#s-avatar .av-head h2{font-size:24px}
.av-head{display:flex;justify-content:space-between;align-items:center;padding:0 16px 12px;margin-top:-30px;position:relative}
.av-head h2{color:var(--orange);font-weight:900;font-size:27px;line-height:1.05;text-align:center}
.coinbox{background:#ffa64d;border-radius:12px;padding:10px 14px;font-size:19px;color:#111;font-weight:500;box-shadow:0 3px 6px rgba(0,0,0,.15)}
.av-stage{background:var(--sky);border-radius:20px 20px 0 0;margin:0 0;position:relative;height:330px}
.av-tools{position:absolute;top:12px;left:14px;display:flex;gap:12px}
.av-tools button{background:none}
.av-tools svg{width:30px;height:30px;stroke:var(--orange2);fill:none;stroke-width:2}
.av-tools button:disabled{opacity:.35}
.shop-btn{position:absolute;top:12px;right:14px;background:none;color:#fff;font-weight:900;font-size:12px;display:flex;flex-direction:column;align-items:center;gap:2px}
.shop-btn svg{width:40px;height:40px;stroke:#fff;fill:none;stroke-width:1.8}
.av-fig{position:absolute;left:50%;top:22px;transform:translateX(-50%);width:200px;height:290px}
.av-fig svg{width:100%;height:100%;filter:drop-shadow(0 8px 10px rgba(0,0,0,.2))}
.av-tabs{position:absolute;bottom:10px;left:10px;right:10px;display:flex;justify-content:space-between}
.av-tabs button{background:none;color:#fff;font-weight:800;font-size:12px;padding:7px 12px;border-radius:12px}
.av-tabs button.on{background:#14306b}
.catbar{background:#0e2a5c;display:flex;justify-content:center;align-items:center;gap:16px;padding:7px;font-weight:800;font-size:13px}
.catbar button{background:none;color:var(--orange2);font-weight:900;font-size:18px}
.items{background:var(--sky);display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:12px;min-height:240px}
.item{background:#7fb0e8;border-radius:12px;aspect-ratio:1/1.1;position:relative;overflow:hidden;border:3px solid transparent;padding:0}
.item svg{width:100%;height:100%}
.item.sel{border-color:#fff;box-shadow:0 0 0 2px var(--ink)}
.item .price{position:absolute;bottom:4px;left:4px;right:4px;background:rgba(10,31,77,.85);color:#ffd180;font-size:11px;font-weight:800;border-radius:8px;padding:3px;display:flex;justify-content:center;align-items:center;gap:3px}
.item .price svg{width:13px;height:13px}
.item .lbl{position:absolute;top:4px;left:4px;background:rgba(255,255,255,.85);color:var(--ink);font-size:10px;font-weight:800;border-radius:6px;padding:2px 5px}
.item .lock{position:absolute;top:4px;right:5px;font-size:13px}
.buybar{position:sticky;bottom:0;background:var(--ink);padding:10px 14px;display:none;align-items:center;justify-content:space-between;gap:10px;font-size:13px;font-weight:700}
.buybar.show{display:flex}
.buybar button{padding:9px 14px;font-size:12px}
.shop-list .si{display:flex;align-items:center;gap:12px;background:#fff;color:var(--ink);border-radius:14px;padding:8px 12px 8px 8px;margin-bottom:10px}
.shop-list .si .th{width:64px;height:64px;border-radius:12px;background:#7fb0e8;overflow:hidden;flex:none}
.shop-list .si .th svg{width:100%;height:100%}
.shop-list .si .nm{flex:1;font-weight:800;font-size:14px}
.shop-list .si .nm small{display:block;font-size:11px;color:#5a6a8c;font-weight:600}
.shop-list .si button{padding:9px 12px;font-size:12px}
.owned-tag{font-size:11px;font-weight:800;color:var(--green)}

/* ---------- COMUNIDAD ---------- */
.search{width:100%;padding:12px 14px;border-radius:14px;border:none;font-size:14px;font-weight:600;margin-bottom:10px;color:var(--ink)}
.hscroll{display:flex;gap:8px;overflow-x:auto;padding-bottom:6px;margin-bottom:10px;scrollbar-width:none}
.hscroll .chip{white-space:nowrap}
.gcard{background:#fff;color:var(--ink);border-radius:16px;padding:14px;margin-bottom:12px;box-shadow:0 4px 10px rgba(0,0,0,.15);cursor:pointer}
.gcard .top{display:flex;gap:12px;align-items:center}
.gicon{width:48px;height:48px;border-radius:14px;display:grid;place-items:center;font-size:24px;flex:none}
.gcard h4{font-size:15px;font-weight:800}
.gcard .m{font-size:11px;font-weight:700;color:#5a6a8c}
.gcard p{font-size:12.5px;margin:8px 0 10px;line-height:1.4;color:#334}
.gcard .ft{display:flex;justify-content:space-between;align-items:center}
.itag{font-size:11px;font-weight:800;background:#eaf1fc;padding:4px 9px;border-radius:12px}
.join{font-size:12px;font-weight:800;padding:8px 14px;border-radius:10px;background:var(--orange2);color:#fff}
.join.in{background:var(--green)}
.ghead{background:var(--navy);color:#fff;border-radius:18px;padding:14px;margin-bottom:12px}
.ghead h3{font-size:18px;font-weight:900}
.ghead .m{font-size:12px;color:#b8c7e6;font-weight:600;margin:4px 0 10px}
.seg{display:flex;background:rgba(255,255,255,.6);border-radius:12px;padding:4px;margin-bottom:12px}
.seg button{flex:1;padding:8px;border-radius:9px;background:none;font-weight:800;font-size:12px;color:var(--ink)}
.seg button.on{background:var(--navy);color:#fff}
.post{background:#fff;color:var(--ink);border-radius:16px;padding:13px;margin-bottom:12px;box-shadow:0 3px 8px rgba(0,0,0,.12)}
.post .who{display:flex;gap:10px;align-items:center;margin-bottom:8px}
.mini{width:36px;height:36px;border-radius:50%;background:#2d8fdc;overflow:hidden;flex:none}
.mini svg{width:100%;height:100%}
.who b{font-size:13px;display:block}
.who small{font-size:11px;color:#5a6a8c;font-weight:600}
.ptype{margin-left:auto;font-size:10px;font-weight:800;padding:3px 8px;border-radius:10px;text-transform:uppercase}
.ptype.q{background:#ffe3cc;color:#b54700}
.ptype.r{background:#d8f5e6;color:#11704a}
.post h5{font-size:14px;font-weight:800;margin-bottom:4px}
.post p{font-size:13px;line-height:1.4;color:#2a3550}
.res-link{display:flex;align-items:center;gap:8px;background:#eef3fb;border-radius:10px;padding:8px 10px;margin-top:8px;font-size:12px;font-weight:700;color:var(--deep);word-break:break-all}
.pact{display:flex;gap:16px;margin-top:10px;font-size:12px;font-weight:800;color:#5a6a8c}
.pact button{background:none;font-weight:800;font-size:12px;color:#5a6a8c}
.pact button.liked{color:var(--red)}
.replies{margin-top:10px;border-top:1px solid #e3ebf8;padding-top:8px;display:none}
.replies.show{display:block}
.reply{font-size:12.5px;background:#f3f6fc;border-radius:10px;padding:7px 10px;margin-bottom:6px}
.reply b{font-size:12px}
.rbox{display:flex;gap:6px}
.rbox input{flex:1;padding:9px;border-radius:10px;border:2px solid #dbe5f5;font-size:13px;font-weight:600}
.rbox button{background:var(--orange2);color:#fff;font-weight:800;border-radius:10px;padding:0 12px;font-size:12px}
.fab{position:absolute;right:18px;bottom:88px;background:var(--orange2);color:#fff;font-weight:900;border-radius:30px;padding:14px 18px;font-size:13px;box-shadow:0 6px 14px rgba(0,0,0,.3);z-index:15;display:none}
.fab.show{display:block}
.joinbanner{background:#fff3e0;color:#7a3a00;border-radius:12px;padding:10px 12px;font-size:12px;font-weight:700;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;gap:10px}
.field{margin-bottom:12px}
.field label{display:block;font-size:12px;font-weight:800;color:#5a6a8c;text-transform:uppercase;margin-bottom:5px}
.field input,.field textarea{width:100%;padding:10px;border-radius:10px;border:2px solid #dbe5f5;font-size:14px;font-weight:600;color:var(--ink)}
.field textarea{height:90px;resize:none}
.empty{text-align:center;color:var(--ink);font-weight:700;font-size:13px;padding:20px}

/* settings */
.set-h{font-size:12px;font-weight:900;color:var(--ink);text-transform:uppercase;margin:16px 4px 8px;letter-spacing:.5px}
.ovr{background:var(--navy);border-radius:16px;padding:14px;margin-bottom:12px;color:#fff}
.ovr .t{display:flex;justify-content:space-between;font-weight:800;font-size:14px;margin-bottom:8px}
.ovr .prog{background:rgba(255,255,255,.2);margin:0}
#settingsBody .story{background:#fff;border-color:#fff;color:var(--ink);box-shadow:0 4px 10px rgba(0,0,0,.12)}
#settingsBody .story.done{border-color:var(--green);background:#eafaf1}
#settingsBody .story h3{color:var(--ink);font-size:13px}
#settingsBody .story p{color:#4a5878;font-size:11.5px}
#settingsBody .story li{color:#8a96b2}
#settingsBody .story li.ok{color:var(--ink)}
#settingsBody .story li .ck{border-color:#c3cde3}
#settingsBody .story .go{background:var(--orange2)}
#settingsBody .reset{color:var(--ink);display:block;margin:6px auto 0}
.gear-dot{position:absolute;top:12px;right:22px;background:var(--orange2);color:#fff;font-size:10px;font-weight:900;border-radius:10px;padding:1px 6px}
.prof{background:#fff;color:var(--ink);border-radius:18px;padding:14px;margin-bottom:10px;box-shadow:0 4px 10px rgba(0,0,0,.15)}
.prof .top{display:flex;gap:14px;align-items:center;margin-bottom:12px}
.prof .avatar-circle{width:76px;height:76px;margin:0;flex:none}
.prof b{font-size:17px;display:block}
.prof small{font-size:12px;font-weight:700;color:#5a6a8c}
.set-row.link{cursor:pointer}
.set-row .ic{display:flex;align-items:center;gap:10px}
.set-row .ic span{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;font-size:18px}
.set-row{background:#fff;color:var(--ink);border-radius:14px;padding:14px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;font-weight:700;font-size:14px}
@media(max-width:860px){.panel{order:2}}
</style>
