    <div class="pad" id="settingsBody"></div>
  </section>

  <button class="fab" id="fab" onclick="openPostModal()">＋ PUBLICAR</button>

  <!-- NAV -->
  <nav class="nav">
    <button data-nav="home" onclick="go('home')" title="Inicio"><svg viewBox="0 0 40 40"><path d="M6 36V17L20 5l14 12v19z"/><path d="M15 36V24a5 5 0 0110 0v12"/></svg></button>
    <button data-nav="community" onclick="openCommunity()" title="Comunidad"><svg viewBox="0 0 40 40"><circle cx="13" cy="10" r="4"/><circle cx="27" cy="10" r="4"/><circle cx="20" cy="21" r="4"/><path d="M5 22c0-4 4-6 8-6M35 22c0-4-4-6-8-6M10 35c0-5 4-8 10-8s10 3 10 8"/></svg></button>
    <button data-nav="settings" onclick="go('settings')" title="Ajustes"><span class="gear-dot" id="gearDot">0/3</span><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="5"/><path d="M20 4l3 4 5-1 1 5 5 2-2 5 3 4-4 3 0 5-5 0-3 4-3-3-5 2-1-5-5-2 1-5-3-4 4-3-1-5 5 0z"/></svg></button>
  </nav>

  <div class="modal" id="modal" onclick="if(event.target===this)closeModal()"><div class="sheet" id="sheet"></div></div>
  <div class="toast" id="toast"></div>
 </div>
