      <button class="btn-orange" id="nextQ" style="width:100%;display:none;margin-top:6px" onclick="SS.idx++;SS.answered=false;renderStudy()">Siguiente ›</button>`;
  }
  if(M==='mapas'){
    const max=S.cfg.ramas, used=SS.branches.map(b=>b.toLowerCase());
    const sugg=DECKS[S.cfg.materia].map(d=>d[0]).filter(s=>!used.includes(s.toLowerCase())).slice(0,5);
    box.innerHTML=`<div class="meta" style="margin:0 0 4px"><span>Estilo ${S.cfg.estilo}</span><span>${SS.branches.length} / ${max} ramas</span></div>
      <div class="mm">${mindMapSVG()}</div>
      ${SS.branches.length<max?`<div class="addrow"><input id="brIn" placeholder="Agrega una idea…" onkeydown="if(event.key==='Enter')addBranch()"><button onclick="addBranch()">＋</button></div>
      <div class="sugg">${sugg.map(s=>`<button onclick="addBranch(this.textContent)">${s}</button>`).join('')}</div>`
      :`<p style="text-align:center;font-weight:800;color:#11704a;margin-top:8px">🧠 ¡Mapa completo! Pulsa «Terminar sesión».</p>`}`;
  }
  if(M==='resumen'){
    const w=SS.text.trim()?SS.text.trim().split(/\s+/).length:0;
    box.innerHTML=`<div class="meta" style="margin:0 0 8px"><span>Resumen · ${S.cfg.formato}</span><span>${esc(SS.tema)}</span></div>
      <textarea id="sumTa" placeholder="${S.cfg.formato==='Viñetas'?'• Idea principal…\n• Concepto clave…':'Escribe tu resumen en un párrafo…'}" oninput="sumInput(this)">${esc(SS.text)}</textarea>
      <div class="prog" style="margin-top:8px"><i id="sumBar" style="width:${Math.min(100,w/SS.target*100)}%"></i></div>
      <div class="meta"><span id="sumW">${w} / ${SS.target} palabras</span><button style="background:none;color:var(--deep);font-weight:800;font-size:12px" onclick="sampleSum()">Insertar ejemplo</button></div>
      <h4 style="font-size:12px;margin-top:10px;text-transform:uppercase;color:#5a6a8c">Conceptos clave a incluir</h4>
      <div class="chk">${SS.keys.map(k=>`<label><input type="checkbox" ${SS.checked.has(k)?'checked':''} onchange="toggleKey('${esc(k)}',this.checked)">${k}</label>`).join('')}</div>`;
  }
}
function fcAns(ok){ if(ok){SS.ok++;addPts(50);}else{SS.fail++;addPts(10);} SS.idx++; renderStudy(); }
function exAns(btn){
  if(SS.answered)return;SS.answered=true;const q=SS.qs[SS.idx];
  document.querySelectorAll('.opt').forEach(o=>{if(o.dataset.o===q.a)o.classList.add('right');});
  if(btn.dataset.o===q.a){SS.ok++;addPts(100);}else{btn.classList.add('wrong');addPts(10);}
  document.getElementById('nextQ').style.display='block';
  if(SS.idx===SS.qs.length-1)document.getElementById('nextQ').textContent='Ver calificación ›';
}
function addBranch(t){
  const v=(t||document.getElementById('brIn').value).trim(); if(!v)return;
  if(SS.branches.length>=S.cfg.ramas)return;
  SS.branches.push(v);addPts(60);renderStudy();const i=document.getElementById('brIn');if(i)i.focus();
}
function mindMapSVG(){
  const W=320,H=230,cx=160,cy=115,B=SS.branches,n=S.cfg.ramas;const cols=['#ff7a00','#5b8def','#2bb673','#ef5350','#6c3fd1','#ffb000'];
  const wrap=(s,l=14)=>s.length>l?s.slice(0,l-1)+'…':s;
  let g='';
  if(S.cfg.estilo==='Radial'){
    for(let i=0;i<n;i++){const ang=-Math.PI/2+i*2*Math.PI/n,x=cx+Math.cos(ang)*108,y=cy+Math.sin(ang)*82,has=i<B.length;
      g+=`<line x1="${cx}" y1="${cy}" x2="${x}" y2="${y}" stroke="${has?cols[i%6]:'#cfd8ea'}" stroke-width="3" ${has?'':'stroke-dasharray="5 5"'}/>
      <rect x="${x-50}" y="${y-14}" width="100" height="28" rx="14" fill="${has?cols[i%6]:'#eef3fb'}"/>
      <text x="${x}" y="${y+4}" text-anchor="middle" font-size="10" font-weight="800" fill="${has?'#fff':'#9aa8c4'}">${has?esc(wrap(B[i])):'+ idea'}</text>`;}
    g+=`<circle cx="${cx}" cy="${cy}" r="38" fill="#2d3e5e"/><text x="${cx}" y="${cy+4}" text-anchor="middle" font-size="11" font-weight="900" fill="#fff">${esc(wrap(SS.tema,12))}</text>`;
  }else{
    g+=`<rect x="10" y="${cy-18}" width="100" height="36" rx="10" fill="#2d3e5e"/><text x="60" y="${cy+4}" text-anchor="middle" font-size="11" font-weight="900" fill="#fff">${esc(wrap(SS.tema,13))}</text>`;
    for(let i=0;i<n;i++){const y=20+i*(H-40)/(Math.max(n-1,1)),has=i<B.length;
      g+=`<path d="M110 ${cy}C140 ${cy} 140 ${y} 175 ${y}" stroke="${has?cols[i%6]:'#cfd8ea'}" stroke-width="3" fill="none" ${has?'':'stroke-dasharray="5 5"'}/>
      <rect x="175" y="${y-13}" width="138" height="26" rx="13" fill="${has?cols[i%6]:'#eef3fb'}"/>
      <text x="244" y="${y+4}" text-anchor="middle" font-size="10" font-weight="800" fill="${has?'#fff':'#9aa8c4'}">${has?esc(wrap(B[i],20)):'+ idea'}</text>`;}
  }
  return `<svg viewBox="0 0 ${W} ${H}">${g}</svg>`;
}
function sumInput(t){SS.text=t.value;const w=t.value.trim()?t.value.trim().split(/\s+/).length:0;
  const prev=SS._w||0;if(w>prev)addPts((w-prev)*3);SS._w=Math.max(prev,w);
  document.getElementById('sumW').textContent=`${w} / ${SS.target} palabras`;document.getElementById('sumBar').style.width=Math.min(100,w/SS.target*100)+'%';}
function sampleSum(){
  const d=DECKS[S.cfg.materia];
  const lines=d.slice(0,6).map(([q,a])=>(S.cfg.formato==='Viñetas'?'• ':'')+`${q}: ${a}.`);
  SS.text=(S.cfg.formato==='Viñetas'?lines.join('\n'):lines.join(' '))+(S.cfg.formato==='Viñetas'?'\n• ':' ')+'Estos conceptos son la base del tema y conviene repasarlos con ejemplos propios antes del examen para fijarlos en la memoria de largo plazo.';
  SS.keys.forEach(k=>SS.checked.add(k));renderStudy();sumInput(document.getElementById('sumTa'));
}
function toggleKey(k,on){on?SS.checked.add(k):SS.checked.delete(k);if(on)addPts(25);}

function sessionProgress(){
  const M=SS.method;
  if(M==='flash')return SS.ok+SS.fail; if(M==='examen')return SS.idx+(SS.answered?1:0);
  if(M==='mapas')return SS.branches.length; return SS._w||0;
}
function confirmEnd(){
  if(sessionProgress()===0){
    openModal(`<h3>¿Terminar sin estudiar?</h3><p>Aún no has avanzado en tu sesión. Si terminas ahora no ganarás puntos ni BCoins.</p>
    <div class="row"><button class="btn-ghost" style="border:2px solid #dbe5f5" onclick="closeModal()">Seguir</button><button class="btn-orange" onclick="closeModal();stopTimer();go('methods')">Salir</button></div>`);return;}
  endSession();
}
function endSession(){
  stopTimer();
  const bonus=200, total=SS.pts+bonus, coins=Math.round(total/5);
  S.points+=total;S.coins+=coins;refreshWallet();mark('hu1',4);
  const M=SS.method, mins=Math.max(1,Math.round(SS.elapsed/60));
  const detail={flash:()=>['Tarjetas dominadas',`${SS.ok} / ${SS.cards.length}`],examen:()=>['Aciertos',`${SS.ok} / ${SS.qs.length}`],
    mapas:()=>['Ramas creadas',`${SS.branches.length} / ${S.cfg.ramas}`],resumen:()=>['Palabras escritas',`${SS._w||0}`]}[M]();
  document.getElementById('doneRes').innerHTML=`
    <div class="r"><span>Técnica</span><span>${METHODS[M].ico} ${METHODS[M].name}</span></div>
    <div class="r"><span>Materia</span><span>${S.cfg.materia}</span></div>
    <div class="r"><span>Tiempo estudiado</span><span>${mins} min (pomodoro ${S.cfg.pomodoro})</span></div>
    <div class="r"><span>${detail[0]}</span><span>${detail[1]}</span></div>
    <div class="r"><span>Bono por terminar</span><b>+${bonus}</b></div>
    <div class="r"><span>Puntos ganados</span><b>+${fmt(total)}</b></div>
    <div class="r"><span>BCoins ganadas</span><b class="bc"><svg viewBox="0 0 24 24" style="width:18px;height:18px"><use href="#bcoin"/></svg>+${fmt(coins)}</b></div>
    ${S.favMethod===M?'<div class="r"><span>★ Guardado como tu método favorito</span><span></span></div>':''}`;
  go('done');
}

